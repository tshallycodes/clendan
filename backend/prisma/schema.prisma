generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id         String   @id @default(cuid())
  name       String
  created_at DateTime @default(now())

  users        User[]
  integrations Integration[]
  tools      Tool[]
  executions   Execution[]
  approvals    Approval[]
  audit_logs   AuditLog[]
  invoices     Invoice[]
  bank_accounts    BankAccount[]
  bank_transactions BankTransaction[]
  api_keys     ApiKey[]
  clerk_org_id        String?  @unique
  industry            String?
  size                String?
  domain              String?
  domain_matching     Boolean  @default(false)
  onboarding_complete Boolean  @default(false)
  members             Member[]
  invitations         Invitation[]
  invite_links        InviteLink[]
  sync_logs               IntegrationSyncLog[]
  reconciliation_runs     ReconciliationRun[]
  accounting_invoices     AccountingInvoice[]
  accounting_bills        AccountingBill[]
  accounting_contacts     AccountingContact[]
  accounting_payments     AccountingPayment[]
  accounting_expenses     AccountingExpense[]
  accounting_accounts     AccountingAccount[]
  accounting_credit_notes AccountingCreditNote[]
  accounting_tax_rates    AccountingTaxRate[]
  payment_runs            PaymentRun[]
  budgets                 Budget[]
}

model User {
  id            String @id @default(cuid())
  tenant_id     String
  clerk_user_id String @unique
  email         String
  role          String @default("member")

  tenant    Tenant     @relation(fields: [tenant_id], references: [id])
  approvals Approval[]

  @@index([tenant_id])
  @@index([clerk_user_id])
}

model Integration {
  id                    String    @id @default(cuid())
  tenant_id             String
  type                  String
  institution_id        String?   // Provider-specific bank identifier (e.g. Plaid ins_xxxxx)
  institution_name      String?   // Display name returned by the provider
  encrypted_credentials String
  status                String    @default("pending")
  connected_at          DateTime?
  last_synced_at        DateTime?
  sync_metadata         Json?

  tenant                  Tenant                 @relation(fields: [tenant_id], references: [id])
  sync_logs               IntegrationSyncLog[]
  bank_accounts           BankAccount[]
  accounting_invoices     AccountingInvoice[]
  accounting_bills        AccountingBill[]
  accounting_contacts     AccountingContact[]
  accounting_payments     AccountingPayment[]
  accounting_expenses     AccountingExpense[]
  accounting_accounts     AccountingAccount[]
  accounting_credit_notes AccountingCreditNote[]
  accounting_tax_rates    AccountingTaxRate[]

  @@index([tenant_id])
  @@index([tenant_id, type])
  @@index([tenant_id, type, institution_id])
}

model IntegrationSyncLog {
  id             String   @id @default(cuid())
  tenant_id      String
  integration_id String
  entity_type    String
  status         String
  records_synced Int      @default(0)
  error_message  String?
  duration_ms    Int?
  created_at     DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenant_id], references: [id])
  integration Integration @relation(fields: [integration_id], references: [id])

  @@index([tenant_id])
  @@index([integration_id])
  @@index([tenant_id, integration_id])
}

model Tool {
  id             String @id @default(cuid())
  tenant_id      String
  type           String
  config_json    Json
  autonomy_level String @default("approve")
  version        Int    @default(1)
  status         String @default("inactive")

  tenant     Tenant      @relation(fields: [tenant_id], references: [id])
  executions Execution[]

  @@index([tenant_id])
}

model Execution {
  id          String   @id @default(cuid())
  tenant_id   String
  tool_id   String
  input_ref   String
  decision    String
  confidence  Float
  status      String
  duration_ms Int?
  created_at  DateTime @default(now())

  tenant   Tenant     @relation(fields: [tenant_id], references: [id])
  tool   Tool     @relation(fields: [tool_id], references: [id])
  approval Approval?
  audit    AuditLog[]

  @@index([tenant_id])
  @@index([tool_id])
}

model Approval {
  id           String    @id @default(cuid())
  tenant_id    String
  execution_id String    @unique
  status       String    @default("pending")
  requested_at DateTime  @default(now())
  responded_at DateTime?
  responder_id String?
  expires_at   DateTime

  tenant    Tenant    @relation(fields: [tenant_id], references: [id])
  execution Execution @relation(fields: [execution_id], references: [id])
  responder User?     @relation(fields: [responder_id], references: [id])

  @@index([tenant_id])
  @@index([execution_id])
}

model AuditLog {
  id                   String   @id @default(cuid())
  tenant_id            String
  execution_id         String?
  actor                String
  action               String
  reasoning_trace_json Json
  model_version        String
  created_at           DateTime @default(now())

  tenant    Tenant     @relation(fields: [tenant_id], references: [id])
  execution Execution? @relation(fields: [execution_id], references: [id])

  @@index([tenant_id])
  @@index([execution_id])
}

model Invoice {
  id               String    @id @default(cuid())
  tenant_id        String
  vendor           String
  invoice_number   String
  amount_minor     Int
  currency         String    @default("GBP")
  due_date         DateTime?
  status           String    @default("pending")
  raw_document_ref String?
  parsed_json      Json?
  created_at       DateTime  @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id])
  bank_transactions BankTransaction[]

  @@index([tenant_id])
  @@index([tenant_id, invoice_number])
}

model BankAccount {
  id                    String   @id @default(cuid())
  tenant_id             String
  integration_id        String?
  source                String   @default("plaid")
  plaid_account_id      String?  @unique
  plaid_item_id         String?
  truelayer_account_id  String?  @unique
  mono_account_id       String?  @unique
  name                  String
  type                  String
  subtype               String?
  current_balance_minor Int
  currency              String   @default("GBP")
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  tenant       Tenant            @relation(fields: [tenant_id], references: [id])
  integration  Integration?      @relation(fields: [integration_id], references: [id])
  transactions BankTransaction[]

  @@index([tenant_id])
  @@index([integration_id])
  @@index([plaid_account_id])
  @@index([truelayer_account_id])
  @@index([mono_account_id])
}

model BankTransaction {
  id                       String    @id @default(cuid())
  tenant_id                String
  account_id               String
  source                   String    @default("plaid")
  plaid_transaction_id     String?   @unique
  truelayer_transaction_id String?   @unique
  mono_transaction_id      String?   @unique
  amount_minor             Int
  currency                 String    @default("GBP")
  merchant_name            String?
  description              String
  date                     DateTime
  category                 String?
  ai_category              String?
  matched_invoice_id       String?
  status                   String    @default("pending")
  created_at               DateTime  @default(now())

  tenant          Tenant      @relation(fields: [tenant_id], references: [id])
  account         BankAccount @relation(fields: [account_id], references: [id])
  matched_invoice Invoice?    @relation(fields: [matched_invoice_id], references: [id])

  @@index([tenant_id])
  @@index([account_id])
  @@index([plaid_transaction_id])
  @@index([truelayer_transaction_id])
  @@index([mono_transaction_id])
  @@index([tenant_id, status])
}

// ---------------------------------------------------------------------------
// Accounting entity models — synced from Xero, QuickBooks, FreshBooks
// All amounts stored as integer minor units (pence/cents). Currency at display layer only.
// Every model: unique(integration_id, external_id) for idempotent upserts.
// ---------------------------------------------------------------------------

model AccountingInvoice {
  id                String    @id @default(cuid())
  tenant_id         String
  integration_id    String
  source            String
  external_id       String

  number            String?
  status            String
  type              String    @default("invoice")
  contact_id        String?
  contact_name      String?
  currency          String    @default("GBP")
  subtotal_cents    Int       @default(0)
  tax_cents         Int       @default(0)
  total_cents       Int       @default(0)
  outstanding_cents Int       @default(0)
  issue_date        DateTime?
  due_date          DateTime?
  paid_at           DateTime?
  line_items        Json?
  raw_data          Json?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  tenant      Tenant      @relation(fields: [tenant_id], references: [id])
  integration Integration @relation(fields: [integration_id], references: [id])

  @@unique([integration_id, external_id])
  @@index([tenant_id])
  @@index([tenant_id, status])
  @@index([tenant_id, due_date])
  @@index([integration_id])
}

model AccountingBill {
  id                String    @id @default(cuid())
  tenant_id         String
  integration_id    String
  source            String
  external_id       String

  number            String?
  status            String
  contact_id        String?
  contact_name      String?
  currency          String    @default("GBP")
  total_cents       Int       @default(0)
  outstanding_cents Int       @default(0)
  issue_date        DateTime?
  due_date          DateTime?
  paid_at           DateTime?
  raw_data          Json?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  tenant      Tenant      @relation(fields: [tenant_id], references: [id])
  integration Integration @relation(fields: [integration_id], references: [id])

  @@unique([integration_id, external_id])
  @@index([tenant_id])
  @@index([tenant_id, status])
  @@index([integration_id])
}

model AccountingContact {
  id           String   @id @default(cuid())
  tenant_id    String
  integration_id String
  source       String
  external_id  String
  contact_type String

  name         String
  email        String?
  phone        String?
  currency     String?
  raw_data     Json?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenant_id], references: [id])
  integration Integration @relation(fields: [integration_id], references: [id])

  @@unique([integration_id, external_id])
  @@index([tenant_id])
  @@index([integration_id])
}

model AccountingPayment {
  id             String    @id @default(cuid())
  tenant_id      String
  integration_id String
  source         String
  external_id    String
  payment_type   String

  amount_cents   Int
  currency       String    @default("GBP")
  reference      String?
  contact_name   String?
  paid_at        DateTime?
  raw_data       Json?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  tenant      Tenant      @relation(fields: [tenant_id], references: [id])
  integration Integration @relation(fields: [integration_id], references: [id])

  @@unique([integration_id, external_id])
  @@index([tenant_id])
  @@index([tenant_id, paid_at])
  @@index([integration_id])
}

model AccountingExpense {
  id             String    @id @default(cuid())
  tenant_id      String
  integration_id String
  source         String
  external_id    String

  category       String?
  account_code   String?
  description    String?
  contact_name   String?
  amount_cents   Int
  currency       String    @default("GBP")
  tax_cents      Int       @default(0)
  expense_date   DateTime?
  approved       Boolean   @default(false)
  raw_data       Json?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  tenant      Tenant      @relation(fields: [tenant_id], references: [id])
  integration Integration @relation(fields: [integration_id], references: [id])

  @@unique([integration_id, external_id])
  @@index([tenant_id])
  @@index([tenant_id, expense_date])
  @@index([integration_id])
}

model AccountingAccount {
  id             String   @id @default(cuid())
  tenant_id      String
  integration_id String
  source         String
  external_id    String

  code           String?
  name           String
  account_type   String
  description    String?
  raw_data       Json?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenant_id], references: [id])
  integration Integration @relation(fields: [integration_id], references: [id])

  @@unique([integration_id, external_id])
  @@index([tenant_id])
  @@index([integration_id])
}

model AccountingCreditNote {
  id              String    @id @default(cuid())
  tenant_id       String
  integration_id  String
  source          String
  external_id     String

  number          String?
  status          String?
  contact_name    String?
  currency        String    @default("GBP")
  total_cents     Int       @default(0)
  remaining_cents Int       @default(0)
  issue_date      DateTime?
  raw_data        Json?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  tenant      Tenant      @relation(fields: [tenant_id], references: [id])
  integration Integration @relation(fields: [integration_id], references: [id])

  @@unique([integration_id, external_id])
  @@index([tenant_id])
  @@index([integration_id])
}

model AccountingTaxRate {
  id             String   @id @default(cuid())
  tenant_id      String
  integration_id String
  source         String
  external_id    String

  name           String
  rate_pct       Float
  tax_type       String?
  raw_data       Json?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenant_id], references: [id])
  integration Integration @relation(fields: [integration_id], references: [id])

  @@unique([integration_id, external_id])
  @@index([tenant_id])
  @@index([integration_id])
}

model ApiKey {
  id           String    @id @default(cuid())
  tenant_id    String
  name         String
  key_hash     String    @unique   // SHA-256 of the full key — never store plain
  key_prefix   String              // First 12 chars, shown in UI (e.g. "ck_live_xQ3f")
  status       String    @default("active")   // "active" | "revoked"
  created_at   DateTime  @default(now())
  last_used_at DateTime?
  expires_at   DateTime?

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([key_hash])
}

enum Role {
  OWNER
  ADMIN
  APPROVER
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Member {
  id            String   @id @default(cuid())
  tenant_id     String
  clerk_user_id String   @unique
  email         String
  role          Role     @default(VIEWER)
  joined_at     DateTime @default(now())

  tenant        Tenant   @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([clerk_user_id])
}

model Invitation {
  id                  String           @id @default(cuid())
  tenant_id           String
  email               String
  role                Role
  status              InvitationStatus @default(PENDING)
  clerk_invitation_id String?
  invited_by          String
  created_at          DateTime         @default(now())
  expires_at          DateTime

  tenant              Tenant           @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
}

model InviteLink {
  id         String   @id @default(cuid())
  tenant_id  String
  token      String   @unique @default(cuid())
  role       Role     @default(VIEWER)
  created_by String
  created_at DateTime @default(now())
  expires_at DateTime

  tenant     Tenant   @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([token])
}

model ReconciliationRun {
  id              String   @id @default(cuid())
  tenant_id       String
  execution_id    String?
  period_start    DateTime
  period_end      DateTime
  status          String   @default("completed")
  matched_count   Int      @default(0)
  unmatched_count Int      @default(0)
  flagged_count   Int      @default(0)
  review_count    Int      @default(0)
  total_txn_count Int      @default(0)
  total_inv_count Int      @default(0)
  details_json    Json?
  created_at      DateTime @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([tenant_id, created_at])
}

model PaymentRun {
  id                 String    @id @default(cuid())
  tenant_id          String
  execution_id       String?
  status             String    @default("scheduled")
  scheduled_for      DateTime
  processed_at       DateTime?
  bill_count         Int       @default(0)
  total_amount_cents Int       @default(0)
  currency           String    @default("GBP")
  bill_ids           Json
  result_json        Json?
  created_at         DateTime  @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([tenant_id, scheduled_for])
  @@index([tenant_id, status])
}

model Budget {
  id           String       @id @default(cuid())
  tenant_id    String
  name         String
  period_start DateTime
  period_end   DateTime
  status       String       @default("active")
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt

  tenant Tenant     @relation(fields: [tenant_id], references: [id])
  lines  BudgetLine[]

  @@index([tenant_id])
  @@index([tenant_id, period_start])
  @@index([tenant_id, status])
}

model BudgetLine {
  id           String   @id @default(cuid())
  budget_id    String
  department   String?
  category     String
  amount_cents Int
  currency     String   @default("GBP")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  budget Budget @relation(fields: [budget_id], references: [id], onDelete: Cascade)

  @@index([budget_id])
}
