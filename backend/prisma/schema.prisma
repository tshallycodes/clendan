generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id         String   @id @default(cuid())
  name       String
  created_at DateTime @default(now())

  users        User[]
  integrations Integration[]
  workers      Worker[]
  executions   Execution[]
  approvals    Approval[]
  audit_logs   AuditLog[]
  invoices     Invoice[]
  bank_accounts    BankAccount[]
  bank_transactions BankTransaction[]
  api_keys     ApiKey[]
  clerk_org_id        String?  @unique
  industry            String?
  size                String?
  domain              String?
  domain_matching     Boolean  @default(false)
  onboarding_complete Boolean  @default(false)
  members             Member[]
  invitations         Invitation[]
  invite_links        InviteLink[]
}

model User {
  id            String @id @default(cuid())
  tenant_id     String
  clerk_user_id String @unique
  email         String
  role          String @default("member")

  tenant    Tenant     @relation(fields: [tenant_id], references: [id])
  approvals Approval[]

  @@index([tenant_id])
  @@index([clerk_user_id])
}

model Integration {
  id                    String    @id @default(cuid())
  tenant_id             String
  type                  String
  encrypted_credentials String
  status                String    @default("pending")
  connected_at          DateTime?

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
}

model Worker {
  id             String @id @default(cuid())
  tenant_id      String
  type           String
  config_json    Json
  autonomy_level String @default("approve")
  version        Int    @default(1)
  status         String @default("inactive")

  tenant     Tenant      @relation(fields: [tenant_id], references: [id])
  executions Execution[]

  @@index([tenant_id])
}

model Execution {
  id          String   @id @default(cuid())
  tenant_id   String
  worker_id   String
  input_ref   String
  decision    String
  confidence  Float
  status      String
  duration_ms Int?
  created_at  DateTime @default(now())

  tenant   Tenant     @relation(fields: [tenant_id], references: [id])
  worker   Worker     @relation(fields: [worker_id], references: [id])
  approval Approval?
  audit    AuditLog[]

  @@index([tenant_id])
  @@index([worker_id])
}

model Approval {
  id           String    @id @default(cuid())
  tenant_id    String
  execution_id String    @unique
  status       String    @default("pending")
  requested_at DateTime  @default(now())
  responded_at DateTime?
  responder_id String?
  expires_at   DateTime

  tenant    Tenant    @relation(fields: [tenant_id], references: [id])
  execution Execution @relation(fields: [execution_id], references: [id])
  responder User?     @relation(fields: [responder_id], references: [id])

  @@index([tenant_id])
  @@index([execution_id])
}

model AuditLog {
  id                   String   @id @default(cuid())
  tenant_id            String
  execution_id         String?
  actor                String
  action               String
  reasoning_trace_json Json
  model_version        String
  created_at           DateTime @default(now())

  tenant    Tenant     @relation(fields: [tenant_id], references: [id])
  execution Execution? @relation(fields: [execution_id], references: [id])

  @@index([tenant_id])
  @@index([execution_id])
}

model Invoice {
  id               String    @id @default(cuid())
  tenant_id        String
  vendor           String
  invoice_number   String
  amount_minor     Int
  currency         String    @default("GBP")
  due_date         DateTime?
  status           String    @default("pending")
  raw_document_ref String?
  parsed_json      Json?
  created_at       DateTime  @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id])
  bank_transactions BankTransaction[]

  @@index([tenant_id])
  @@index([tenant_id, invoice_number])
}

model BankAccount {
  id                    String   @id @default(cuid())
  tenant_id             String
  plaid_account_id      String   @unique
  plaid_item_id         String
  name                  String
  type                  String
  subtype               String
  current_balance_minor Int
  currency              String   @default("USD")
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  tenant       Tenant            @relation(fields: [tenant_id], references: [id])
  transactions BankTransaction[]

  @@index([tenant_id])
  @@index([plaid_account_id])
}

model BankTransaction {
  id                   String    @id @default(cuid())
  tenant_id            String
  account_id           String
  plaid_transaction_id String    @unique
  amount_minor         Int
  currency             String    @default("USD")
  merchant_name        String?
  description          String
  date                 DateTime
  category             String?
  ai_category          String?
  matched_invoice_id   String?
  status               String    @default("pending")
  created_at           DateTime  @default(now())

  tenant          Tenant      @relation(fields: [tenant_id], references: [id])
  account         BankAccount @relation(fields: [account_id], references: [id])
  matched_invoice Invoice?    @relation(fields: [matched_invoice_id], references: [id])

  @@index([tenant_id])
  @@index([account_id])
  @@index([plaid_transaction_id])
  @@index([tenant_id, status])
}

model ApiKey {
  id           String    @id @default(cuid())
  tenant_id    String
  name         String
  key_hash     String    @unique   // SHA-256 of the full key — never store plain
  key_prefix   String              // First 12 chars, shown in UI (e.g. "ck_live_xQ3f")
  status       String    @default("active")   // "active" | "revoked"
  created_at   DateTime  @default(now())
  last_used_at DateTime?
  expires_at   DateTime?

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([key_hash])
}

enum Role {
  OWNER
  ADMIN
  APPROVER
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Member {
  id            String   @id @default(cuid())
  tenant_id     String
  clerk_user_id String   @unique
  email         String
  role          Role     @default(VIEWER)
  joined_at     DateTime @default(now())

  tenant        Tenant   @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([clerk_user_id])
}

model Invitation {
  id                  String           @id @default(cuid())
  tenant_id           String
  email               String
  role                Role
  status              InvitationStatus @default(PENDING)
  clerk_invitation_id String?
  invited_by          String
  created_at          DateTime         @default(now())
  expires_at          DateTime

  tenant              Tenant           @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
}

model InviteLink {
  id         String   @id @default(cuid())
  tenant_id  String
  token      String   @unique @default(cuid())
  role       Role     @default(VIEWER)
  created_by String
  created_at DateTime @default(now())
  expires_at DateTime

  tenant     Tenant   @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([token])
}
