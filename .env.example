# Application
ENVIRONMENT=development
DEBUG=false

# Database (PostgreSQL)
DATABASE_URL=postgresql://clendan:password@localhost:5432/clendan

# Redis
REDIS_URL=redis://localhost:6379/0

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_FRONTEND_API=your-frontend-api.clerk.accounts.dev

# Anthropic (backend only — never expose to client)
ANTHROPIC_API_KEY=sk-ant-...

# Sentry Error Monitoring
SENTRY_DSN=

# Encryption (32-byte base64-encoded key for tenant credential encryption)
ENCRYPTION_KEY=

# PostHog Product Analytics
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
