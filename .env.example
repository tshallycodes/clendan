# Application
APP_NAME=Clendan
ENVIRONMENT=development
DEBUG=false

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/clendan

# Redis
REDIS_URL=redis://localhost:6379/0

# Clerk Auth
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_FRONTEND_API=

# Anthropic
ANTHROPIC_API_KEY=

# Observability
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# Encryption (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
ENCRYPTION_KEY=

# QuickBooks Integration
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:8000/v1/integrations/quickbooks/callback
QUICKBOOKS_SANDBOX=true
